{
  "name": "ethanolson",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview:storyblok": "next build && node scripts/storyblok-preview.mjs",
